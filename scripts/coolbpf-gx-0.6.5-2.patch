+#[cfg(test)]
+mod gx_version_tests {
+    use super::gx_package_is_current;
+
+    #[test]
+    fn deb_requires_the_exact_configured_version() {
+        assert!(gx_package_is_current("install ok installed\t0.6.5-2\n", false));
+        for metadata in [
+            "install ok installed\t0.6.2-5",
+            "install ok unpacked\t0.6.5-2",
+            "deinstall ok config-files\t0.6.5-2",
+            "install ok installed\t0.6.5-3",
+            "",
+        ] {
+            assert!(!gx_package_is_current(metadata, false));
+        }
+    }
+
+    #[test]
+    fn rpm_checks_both_version_and_release() {
+        assert!(gx_package_is_current("0.6.5-2.al8\n", true));
+        for metadata in ["0.6.2-5.al8", "0.6.5", "0.6.5-1.al8", "0.6.5-2.al9", ""] {
+            assert!(!gx_package_is_current(metadata, true));
+        }
+    }
+}
