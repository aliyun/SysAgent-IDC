[Unit]
Description=SysAgent sysAK IDC local service
After=local-fs.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/bin/python3 -I -B /opt/SysAgent管家/resources/sysak-root-runner.py
Restart=on-failure
RestartSec=5
RuntimeDirectory=sysom-idc
RuntimeDirectoryMode=0755
KillMode=control-group
TimeoutStopSec=5
NoNewPrivileges=true
UMask=0077
TasksMax=64
MemoryMax=512M

[Install]
WantedBy=multi-user.target
