def timestamp():
    return datetime.now(timezone.utc).isoformat(timespec="milliseconds")


def item(status, source, content=None, **detail):
    return dict(status=status, source=source, content=content,
                sampled_at=timestamp(), **detail)


def failure(source, exc):
    code = getattr(exc, "errno", None)
    status = "error"
    if code in (errno.ENOENT, errno.ENOTDIR, errno.ENODEV):
        status = "unavailable"
    elif code in (errno.EACCES, errno.EPERM):
        status = "permission_denied"
    return item(status, source, error_type=type(exc).__name__, errno=code)


def raw_items(value):
    if isinstance(value, dict):
        if {"status", "source", "content", "sampled_at"}.issubset(value):
            yield value
        else:
            for child in value.values():
                yield from raw_items(child)
    elif isinstance(value, list):
        for child in value:
            yield from raw_items(child)


def combined_status(values):
    statuses = [value["status"] for value in values]
    if not statuses or all(status == "ok" for status in statuses):
        return "ok"
    return "partial" if "ok" in statuses else "error"


def whitelisted_fields(text, allowed):
    return {key: value.strip() for line in text.splitlines()
            for key, separator, value in (line.partition(":"),)
            if separator and key in allowed}


def sample_status(has_values, failures, truncated):
    if truncated:
        return "truncated"
    if not failures:
        return "ok"
    statuses = {value["status"] for value in failures}
    if not has_values and len(statuses) == 1:
        return next(iter(statuses))
    return "partial"


def paired(first, second):
    first["content"]["samples"].extend(second["content"]["samples"])
    first["sample_statuses"].extend(second["sample_statuses"])
    statuses = {first["status"], second["status"]}
    first["status"] = ("truncated" if "truncated" in statuses else
                       next(iter(statuses)) if len(statuses) == 1 else "partial")
    return first


def report_text(value, limit=1024):
    return isinstance(value, str) and len(value) <= limit


def report_number(value, maximum=sys.float_info.max, integer=False):
    if value is None:
        return True
    if integer:
        return type(value) is int and 0 <= value <= min(maximum, MAX_SAFE_INTEGER)
    return (type(value) in (int, float) and 0 <= value <= maximum and
            (type(value) is not int or value <= MAX_SAFE_INTEGER))


def report_details(details):
    if not isinstance(details, list) or len(details) > 256:
        raise ValueError("invalid AI details")
    for detail in details:
        if (not isinstance(detail, dict) or
                not {"check", "severity", "message"}.issubset(detail) or
                set(detail) - {"check", "severity", "message", "suggestion"} or
                detail["severity"] not in ("OK", "WARN", "ERROR") or
                not all(report_text(value) for value in detail.values())):
            raise ValueError("invalid AI detail")


def ai_report_json(data):
    # Duplicate keys must not hide unsafe fields or contradict validated evidence.
    def unique_object(pairs):
        result = {}
        for key, value in pairs:
            if key in result:
                raise ValueError("duplicate AI report key")
            result[key] = value
        return result
    return json.loads(data, object_pairs_hook=unique_object)


def ai_report_status(content):
    common = {"schema_version", "tool", "mode", "read_only", "status", "gpu_count"}
    if set(content) != common | {"gpu_arch", "gpu_devices", "details", "coverage",
                                "gpu_metrics", "job_analysis"}:
        raise ValueError("invalid AI report fields")
    count, coverage = content["gpu_count"], content["coverage"]
    if not (count is None or type(count) is int and 0 <= count <= 32):
        raise ValueError("invalid AI GPU count")
    if (not isinstance(coverage, dict) or set(coverage) != {"complete", "reason"} or
            type(coverage["complete"]) is not bool or not report_text(coverage["reason"], 512) or
            content["status"] == "ok" and not coverage["complete"] or
            coverage["complete"] and (count is None or content["status"] not in ("ok", "partial"))):
        raise ValueError("invalid AI coverage")
    for name in ("gpu_arch", "gpu_devices"):
        values = content[name]
        if (not isinstance(values, list) or len(values) > 32 or
                not all(report_text(value, 128) for value in values)):
            raise ValueError("invalid AI inventory")
    devices = content["gpu_devices"]
    if (not all(re.fullmatch(r"(?:(?:[0-9a-fA-F]{4}|[0-9a-fA-F]{8}):)?"
                            r"[0-9a-fA-F]{2}:[01][0-9a-fA-F]\.[0-7]", value)
                for value in devices) or
            count == 0 and (devices or content["gpu_arch"]) or
            count is not None and (len(devices) > count or
                                   coverage["complete"] and len(devices) != count)):
        raise ValueError("inconsistent AI inventory")
    report_details(content["details"])
    metrics = content["gpu_metrics"]
    if not isinstance(metrics, list) or len(metrics) > 32:
        raise ValueError("invalid AI GPU metrics")
    indices = set()
    for metric in metrics:
        if not isinstance(metric, dict) or set(metric) != AI_METRIC_FIELDS:
            raise ValueError("invalid AI GPU metric fields")
        index = metric["index"]
        if (type(index) is not int or not 0 <= index <= 31 or index in indices or
                count is not None and index >= count or
                not all(report_text(metric[name], 256) for name in ("name", "uuid", "busId"))):
            raise ValueError("invalid AI GPU identity")
        indices.add(index)
        for name in AI_METRIC_FIELDS - {"index", "name", "uuid", "busId"}:
            maximum = 100 if name in ("utilization", "memoryUtilization") else sys.float_info.max
            if not report_number(metric[name], maximum, name in AI_INTEGER_METRICS):
                raise ValueError("invalid AI GPU counter")
    jobs = content["job_analysis"]
    if (not isinstance(jobs, dict) or
            set(jobs) != {"status", "complete", "reason", "sample_window_seconds", "processes"} or
            jobs["status"] not in GPU_REPORT_STATUSES or type(jobs["complete"]) is not bool or
            not report_text(jobs["reason"], 512) or
            not (jobs["sample_window_seconds"] is None or
                 type(jobs["sample_window_seconds"]) in (int, float) and
                 0 < jobs["sample_window_seconds"] <= 10) or
            jobs["status"] == "ok" and not jobs["complete"] or
            jobs["complete"] and jobs["status"] not in ("ok", "partial") or
            not isinstance(jobs["processes"], list) or len(jobs["processes"]) > 128):
        raise ValueError("invalid AI job analysis")
    pids = set()
    for process in jobs["processes"]:
        if not isinstance(process, dict) or set(process) != AI_PROCESS_FIELDS:
            raise ValueError("invalid AI process fields")
        pid, gpu_indices = process["pid"], process["gpu_indices"]
        if (type(pid) is not int or not 1 <= pid <= MAX_PID or pid in pids or
                not report_number(process["starttime"], integer=True) or
                not report_text(process["name"], 256) or not report_text(process["state"], 32) or
                not report_number(process["cpu_percent"]) or
                not report_number(process["rss_bytes"], integer=True) or
                not report_number(process["sm_utilization"], 100) or
                not report_number(process["memory_utilization"], 100) or
                process["status"] not in GPU_REPORT_STATUSES | {"not_run"} or
                not isinstance(gpu_indices, list) or len(gpu_indices) > 32 or
                not all(type(index) is int and 0 <= index <= 31 and
                        (count is None or index < count) for index in gpu_indices) or
                len(set(gpu_indices)) != len(gpu_indices)):
            raise ValueError("invalid AI process")
        pids.add(pid)
        report_details(process["findings"])
    return content["status"]


def native_ai_report(content):
    fields = {"gpus", "processes", "summary", "summary_en", "errors", "errors_en",
              "sysom_code", "sysom_err_msg", "sysom_err_msg_en"}
    if (not isinstance(content, dict) or set(content) != fields or
            type(content["sysom_code"]) is not int or content["sysom_code"] not in (0, 1) or
            not all(report_text(content[name], MAX_JSON_BYTES) for name in
                    ("summary", "summary_en", "sysom_err_msg", "sysom_err_msg_en"))):
        raise ValueError("invalid native AI report")
    gpus, processes = content["gpus"], content["processes"]
    if (not isinstance(gpus, list) or len(gpus) > 32 or
            not isinstance(processes, dict) or len(processes) > 128):
        raise ValueError("invalid native AI inventory")
    details, metrics, jobs = [], [], []

    def finding(message, suggestion="", prefix="native_ai"):
        check = "pci_inventory" if message.startswith(("PCI检测:", "PCI check:")) else prefix
        xid = re.search(r"\bXid(?:编号是[：:]|\s+number:|\s*[:=]?)\s*(\d+)\b", message, re.I)
        if xid:
            check = "Xid" + xid.group(1)[:10]
        elif "nccl" in message.lower():
            check = "nccl"
        elif "hang" in message.lower():
            check = "hang"
        return {"check": check, "severity": "ERROR", "message": message,
                **({"suggestion": suggestion} if suggestion else {})}

    def native_errors(errors, prefix):
        if not isinstance(errors, list) or len(errors) > 256:
            raise ValueError("invalid native AI errors")
        result = []
        for error in errors:
            if (not isinstance(error, dict) or set(error) !=
                    {"time", "info", "sugg", "info_en", "sugg_en"} or
                    not all(report_text(value) for value in error.values())):
                raise ValueError("invalid native AI error")
            result.append(finding(error["info"] or error["info_en"],
                                  error["sugg"] or error["sugg_en"], prefix))
        return result

    def required_number(value, maximum=MAX_SAFE_INTEGER, integer=False):
        if value is None or not report_number(value, maximum, integer):
            raise ValueError("invalid native AI measurement")
        return value

    for index, gpu in enumerate(gpus):
        if (not isinstance(gpu, dict) or set(gpu) !=
                {"fan", "temp", "perf", "power", "util", "mem", "normal", "erros"} or
                type(gpu["normal"]) is not bool or not report_text(gpu["perf"], 32) or
                not isinstance(gpu["mem"], dict) or set(gpu["mem"]) != {"total", "free", "used"}):
            raise ValueError("invalid native AI GPU")
        required_number(gpu["fan"], 100, True)
        memory = {key: required_number(value, integer=True) for key, value in gpu["mem"].items()}
        if memory["used"] > memory["total"] or memory["free"] > memory["total"]:
            raise ValueError("inconsistent native AI memory")
        metric = dict.fromkeys(AI_METRIC_FIELDS)
        metric.update(index=index, name="", uuid="", busId="",
                      utilization=required_number(gpu["util"], 100, True),
                      memoryUsedBytes=memory["used"], memoryTotalBytes=memory["total"],
                      temperatureCelsius=required_number(gpu["temp"], integer=True),
                      powerWatts=required_number(gpu["power"], integer=True))
        metrics.append(metric)
        findings = native_errors(gpu["erros"], "gpu_" + str(index))
        if not gpu["normal"] and not findings:
            findings.append(finding("原始 AI 标记此 GPU 异常，但未提供细节", "", "gpu_" + str(index)))
        details.extend(findings)

    for pid_key, process in processes.items():
        if (not isinstance(pid_key, str) or not re.fullmatch(r"[1-9][0-9]{0,9}", pid_key) or
                not isinstance(process, dict) or set(process) !=
                {"pid", "cpu_util", "mem", "cmd", "gpus", "normal", "erros"} or
                type(process["pid"]) is not int or process["pid"] != int(pid_key) or
                not 1 <= process["pid"] <= MAX_PID or type(process["normal"]) is not bool or
                not report_text(process["cmd"], 256) or
                not isinstance(process["gpus"], list) or len(process["gpus"]) > 32):
            raise ValueError("invalid native AI process")
        associations = process["gpus"]
        indices = []
        for gpu in associations:
            if (not isinstance(gpu, dict) or set(gpu) != {"id", "mem_util", "sm_util"} or
                    type(gpu["id"]) is not int or not 0 <= gpu["id"] < len(gpus) or
                    gpu["id"] in indices):
                raise ValueError("invalid native AI process GPU")
            required_number(gpu["mem_util"], 100, True)
            required_number(gpu["sm_util"], 100, True)
            indices.append(gpu["id"])
        findings = native_errors(process["erros"], "job")
        if not process["normal"] and not findings:
            findings.append(finding("原始 AI 标记此进程异常，但未提供细节", "", "job"))
        details.extend(findings)
        # Native cmd contains arguments, not comm; no starttime or common metric window is exported.
        jobs.append({"pid": process["pid"], "starttime": None, "name": "", "state": "",
                     "cpu_percent": required_number(process["cpu_util"]),
                     "rss_bytes": required_number(process["mem"], integer=True),
                     "gpu_indices": indices,
                     "sm_utilization": associations[0]["sm_util"] if len(associations) == 1 else None,
                     "memory_utilization": associations[0]["mem_util"] if len(associations) == 1 else None,
                     "status": "partial", "findings": findings})
    for name in ("errors", "errors_en"):
        errors = content[name]
        if (not isinstance(errors, list) or len(errors) > 256 or
                not all(report_text(error) for error in errors)):
            raise ValueError("invalid native AI summary errors")
    for error in content["errors"] or content["errors_en"]:
        if not any(detail["message"] and detail["message"] in error for detail in details):
            details.append(finding(error))
    reason = ("原始 AI 未提供 PCI 身份、逐项执行覆盖或统一作业采样窗口；"
              "空结果不证明无 GPU，未发现错误也不证明整体正常")
    if content["sysom_code"] == 1:
        reason = "原始 AI 报告无可用 GPU 或驱动；不能区分未安装驱动与无 GPU"
    report = {"schema_version": "1.0", "tool": "ai", "mode": "native", "read_only": False,
              "status": "partial" if gpus or jobs or details else "unavailable",
              "gpu_count": len(gpus) if gpus else None, "gpu_arch": [], "gpu_devices": [],
              "details": details, "coverage": {"complete": False, "reason": reason},
              "gpu_metrics": metrics,
              "job_analysis": {"status": "partial" if jobs else "unavailable", "complete": False,
                               "reason": "原始 AI 只返回已观测进程，未提供进程身份或 GX 执行覆盖",
                               "sample_window_seconds": None, "processes": jobs}}
    gpu_report_status("ai", report)
    return report


def gpu_csv_report(data):
    devices, indices, incomplete = [], set(), False
    for parts in csv.reader(io.StringIO(data.decode("utf-8")), strict=True):
        if not parts:
            continue
        parts = [part.strip() for part in parts]
        if (len(parts) != len(GPU_CSV_FIELDS) or
                not re.fullmatch(r"0|[1-9][0-9]{0,9}", parts[0]) or
                int(parts[0]) in indices or
                not all(report_text(part, 256) for part in parts)):
            incomplete = True
            continue
        if len(devices) >= 256:
            raise ValueError("GPU inventory exceeds limit")
        indices.add(int(parts[0]))
        incomplete = incomplete or any(not part or part.upper() in
                                      ("N/A", "[N/A]", "[NOT SUPPORTED]") for part in parts)
        for value in parts[3:-1]:
            try:
                number = float(value)
                if not 0 <= number <= sys.float_info.max:
                    incomplete = True
            except ValueError:
                incomplete = True
        devices.append(dict(zip(GPU_CSV_FIELDS, parts)))
    if incomplete and not devices:
        raise ValueError("invalid GPU CSV inventory")
    status = "partial" if incomplete else "ok"
    report = {"schema_version": "1.0", "tool": "idc", "mode": "idc",
              "read_only": True, "status": status, "available": True,
              "gpu_count": len(devices), "devices": devices}
    if incomplete:
        report["reason"] = "smi_fields_incomplete"
    elif not devices:
        report["reason"] = "no_nvidia_devices_in_successful_smi_query"
    gpu_report_status("gpu", report)
    return report


def gpu_report_status(key, content):
    tool = "idc" if key == "gpu" else "ai"
    if (not isinstance(content, dict) or content.get("schema_version") != "1.0" or
            content.get("tool") != tool or
            content.get("mode") != ("native" if key == "ai" else "idc") or
            content.get("read_only") is not (False if key == "ai" else True) or
            content.get("status") not in GPU_REPORT_STATUSES):
        raise ValueError("invalid GPU safe-profile report")
    if key == "ai":
        return ai_report_status(content)
    count = content.get("gpu_count")
    if not (type(count) is int and 0 <= count <= 256):
        raise ValueError("invalid GPU count")
    common = {"schema_version", "tool", "mode", "read_only", "status", "gpu_count"}
    devices = content.get("devices")
    if (set(content) - (common | {"available", "reason", "devices"}) or
            type(content.get("available")) is not bool or
            content["available"] != (content["status"] in ("ok", "partial")) or
            not isinstance(devices, list) or len(devices) != count or
            not all(isinstance(dev, dict) and set(dev) == GPU_DEVICE_FIELDS and
                    all(report_text(value, 256) for value in dev.values()) for dev in devices) or
            "reason" in content and not report_text(content["reason"], 128)):
        raise ValueError("invalid GPU snapshot")
    return content["status"]


def diagnostic_report_status(key, content):
    if key in ("gpu", "ai"):
        return gpu_report_status(key, content)
    if key == "memgraph":
        # Native JSON has no IDC/read-only or per-plugin coverage contract.
        graph = content.get("memgraph")
        if (content.get("version") != "2.0" or "mode" in content or
                "read_only" in content or not isinstance(graph, dict)):
            raise ValueError("invalid native memgraph report")
        for name in ("total", "avaliable"):
            value = graph.get(name)
            if (type(value) not in (int, float) or
                    not (0 <= value <= sys.float_info.max)):
                raise ValueError("invalid native memgraph counter")
        if graph["total"] <= 0 or graph["avaliable"] > graph["total"]:
            raise ValueError("invalid native memgraph capacity")
        # Successful exit and a valid graph do not prove all plugins completed.
        return "partial"
    if content.get("mode") != "idc" or content.get("read_only") is not True:
        raise ValueError("not a safe-profile report")
    allowed = {"ok", "partial", "error", "unavailable", "permission_denied",
               "timeout", "truncated"}
    if key != "resource_anomaly" or content.get("schema_version") != "1.0" or not all(
            isinstance(content.get(name), dict) for name in ("root", "fd")):
        raise ValueError("invalid resource_anomaly report")
    statuses = {content[name].get("status") for name in ("root", "fd")}
    if not statuses.issubset(allowed):
        raise ValueError("invalid diagnostic status")
    return next(iter(statuses)) if len(statuses) == 1 else "partial"


def cpu_count(evidence):
    if evidence["status"] != "ok":
        return item(evidence["status"], evidence["source"],
                    reason="per_cpu_stat_not_available")
    count = sum(bool(re.match(r"^cpu[0-9]+\s", line))
                for line in evidence["content"].splitlines())
    return item("ok" if count else "unavailable", evidence["source"],
                count if count else None, scope="current procfs per-cpu stat lines")


class Backend:
    def __init__(self, proc_root="/proc", sys_root="/sys", fs_root="/",
                 script_dir=None, opener=None, runner=None, scandir=None,
                 readlink=None, statvfs=None, sleep=None, monotonic=None,
                 device=None, sysconf=None, now=None):
        self.proc_root = Path(proc_root)
        self.sys_root = Path(sys_root)
        self.fs_root = str(fs_root)
        self.script_dir = Path(script_dir or Path(__file__).resolve().parent)
        self.opener = opener or open
        self.runner = runner
        self.scandir = scandir or os.scandir
        self.readlink = readlink or os.readlink
        self.statvfs = statvfs or os.statvfs
        self.sleep = sleep or time.sleep
        self.monotonic = monotonic or time.monotonic
        self.sysconf = sysconf or os.sysconf
        self.now = now or timestamp
        self.deadline = None
        self.device = device or {
            "platform": platform.system(), "machine": platform.machine(),
            "hostname": socket.gethostname(), "scope": "local",
        }

    def remaining(self):
        return (max(0, self.deadline - self.monotonic())
                if self.deadline is not None else MAX_COLLECTION_SECONDS)

    def read(self, path):
        source = str(path)
        if self.remaining() <= 0:
            return item("timeout", source, reason="collection_deadline")
        try:
            with self.opener(source, "rb") as stream:
                data = stream.read(MAX_FILE_BYTES + 1)
        except OSError as exc:
            return failure(source, exc)
        truncated = len(data) > MAX_FILE_BYTES
        result = item("truncated" if truncated else "ok", source,
                      data[:MAX_FILE_BYTES].decode("utf-8", "replace"))
        if truncated:
            result.update(limit_bytes=MAX_FILE_BYTES, bytes_read=len(data))
        return result

    def root_filesystem(self):
        if self.remaining() <= 0:
            return item("timeout", "statvfs:" + self.fs_root, reason="collection_deadline")
        try:
            stat = self.statvfs(self.fs_root)
            content = {key: getattr(stat, key) for key in (
                "f_bsize", "f_frsize", "f_blocks", "f_bfree", "f_bavail",
                "f_files", "f_ffree", "f_favail", "f_flag", "f_namemax",
                "f_fsid",
            ) if hasattr(stat, key)}
            return item("ok", "statvfs:" + self.fs_root, content)
        except OSError as exc:
            return failure("statvfs:" + self.fs_root, exc)

    def diagnostic_entry(self, key):
        # Only fixed bundled locations; never search PATH or accept caller paths.
        if key == "ai":
            paths = (self.script_dir / "ai",
                     self.script_dir.parent.parent / "ai/target/release/ai")
            return next((path for path in paths if path.is_file()), None)
        installed = (
            self.script_dir / key / (key + ".py"),
            self.script_dir / key,
            self.script_dir / (key + ".py"),
            self.script_dir.parent / key / (key + ".py"),
        )
        source = (self.script_dir.parent / key / (key + ".py")
                  if key == "resource_anomaly" else
                  self.script_dir.parent.parent / "mem/memgraph/memgraph.py")
        return next((path for path in (*installed, source) if path.is_file()), None)

    def _run_command(self, argv, timeout, limit, cleanup_budget=0):
        # Keep the child unreaped until signalling finishes, even if descendants hold pipes open.
        if not hasattr(os, "pidfd_open") or not hasattr(signal, "pidfd_send_signal"):
            raise OSError(errno.ENOSYS, "command runner requires Linux pidfds")
        command_end = self.monotonic() + timeout
        deadline = command_end - min(cleanup_budget, timeout / 10)
        child, pidfd, selector = None, None, None
        exited, reaped = False, False
        output = bytearray()
        counts = {"stdout": 0, "stderr": 0}
        caps = {"stdout": limit, "stderr": 1024 * 1024}

        def completed(returncode):
            return (subprocess.CompletedProcess(argv, returncode, bytes(output), b""),
                    counts["stdout"], counts["stderr"])

        try:
            # Inherit the broker group; a Popen context manager would wait without a deadline.
            child = subprocess.Popen(argv, shell=False, stdin=subprocess.DEVNULL,
                                     stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                     bufsize=0)
            pidfd = os.pidfd_open(child.pid, 0)
            selector = selectors.DefaultSelector()
            selector.register(pidfd, selectors.EVENT_READ, "exit")
            for name in counts:
                stream = getattr(child, name)
                os.set_blocking(stream.fileno(), False)
                selector.register(stream.fileno(), selectors.EVENT_READ, name)
            pipes = 2
            while pipes or not exited:
                remaining = deadline - self.monotonic()
                if remaining <= 0:
                    raise subprocess.TimeoutExpired(argv, timeout, output=bytes(output))
                try:
                    ready = selector.select(remaining)
                except InterruptedError:
                    continue
                # Observe exit before handling output, regardless of event order.
                if any(key.data == "exit" for key, _ in ready):
                    exited = True
                    selector.unregister(pidfd)
                for key, _ in ready:
                    name = key.data
                    if name == "exit":
                        continue
                    if self.monotonic() >= deadline:
                        raise subprocess.TimeoutExpired(argv, timeout, output=bytes(output))
                    try:
                        # One bounded read per stream prevents backpressure from starving deadline checks.
                        data = os.read(key.fd, min(64 * 1024,
                                                  caps[name] - counts[name] + 1))
                    except (BlockingIOError, InterruptedError):
                        continue
                    if not data:
                        selector.unregister(key.fd)
                        pipes -= 1
                        continue
                    counts[name] += len(data)
                    if name == "stdout":
                        output.extend(data[:max(0, limit - len(output))])
                    # Read only one byte beyond a cap; never accumulate stderr.
                    if counts[name] > caps[name]:
                        return completed(child.returncode)
            remaining = deadline - self.monotonic()
            if remaining <= 0:
                raise subprocess.TimeoutExpired(argv, timeout, output=bytes(output))
            try:
                returncode = child.wait(timeout=remaining)
            except subprocess.TimeoutExpired as exc:
                raise subprocess.TimeoutExpired(argv, timeout, output=bytes(output)) from exc
            reaped = True
            return completed(returncode)
        finally:
            # Only the broker owns descendant cancellation; cleanup cannot extend collection time.
            cleanup_deadline = self.monotonic() + 0.25
            if cleanup_budget:
                cleanup_deadline = min(cleanup_deadline, command_end)
            if self.deadline is not None:
                cleanup_deadline = min(cleanup_deadline, self.deadline)
            if selector is not None:
                try:
                    selector.close()
                except OSError:
                    pass
            if child is not None:
                for stream in (child.stdout, child.stderr):
                    if stream is not None:
                        try:
                            stream.close()
                        except OSError:
                            pass
                if not reaped:
                    if not exited and child.returncode is None:
                        try:
                            if pidfd is not None:
                                signal.pidfd_send_signal(pidfd, signal.SIGKILL, None, 0)
                            else:
                                # Without a pidfd this unreaped Popen child is still exclusively owned.
                                child.kill()
                        except OSError:
                            pass
                    try:
                        child.wait(timeout=max(0, cleanup_deadline - self.monotonic()))
                    except (subprocess.TimeoutExpired, OSError):
                        pass
            if pidfd is not None:
                try:
                    os.close(pidfd)
                except OSError:
                    pass

    def command(self, key):
        if key == "gpu":
            argv, timeout, limit = list(COMMANDS[key]), 5, MAX_JSON_BYTES
        elif key in JSON_COMPONENTS:
            source = "bundled:" + key + (":native" if key in ("memgraph", "ai") else ":idc")
            if self.remaining() <= 0:
                return item("timeout", source, reason="collection_deadline")
            try:
                path = self.diagnostic_entry(key)
            except OSError as exc:
                return failure(source, exc)
            if path is None:
                return item("unavailable", source, reason="component_not_installed")
            argv = ([str(path), *DIAGNOSTIC_FLAGS[key]] if key == "ai" else
                    [sys.executable, "-B", str(path), *DIAGNOSTIC_FLAGS.get(key, ())])
            timeout, limit = (10 if key == "ai" else 5), MAX_JSON_BYTES
        else:
            argv = list(COMMANDS[key])
            timeout, limit = 5, MAX_FILE_BYTES
        source = {"argv": argv}
        remaining = self.remaining()
        if remaining <= 0:
            return item("timeout", source, reason="collection_deadline")
        timeout = min(timeout, remaining)
        try:
            if self.runner is None:
                result, stdout_bytes, stderr_bytes = self._run_command(
                    argv, timeout, limit, cleanup_budget=0.25 if key in ("gpu", "ai") else 0)
                data = result.stdout
            else:
                result = self.runner(argv, shell=False, stdout=subprocess.PIPE,
                                     stderr=subprocess.PIPE, timeout=timeout,
                                     check=False)
                data = result.stdout or b""
                if isinstance(data, str):
                    data = data.encode("utf-8")
                stderr = result.stderr or b""
                if isinstance(stderr, str):
                    stderr = stderr.encode("utf-8")
                stdout_bytes, stderr_bytes = len(data), len(stderr)
        except subprocess.TimeoutExpired as exc:
            if key == "ai" and exc.output:
                try:
                    data = exc.output.encode("utf-8") if isinstance(exc.output, str) else exc.output
                    if len(data) > limit:
                        raise ValueError("timeout report exceeds limit")
                    content = ai_report_json(data)
                    json.dumps(content, allow_nan=False)
                    content = native_ai_report(content)
                    status = gpu_report_status(key, content)
                    return item("timeout", source, content, original_status=status,
                                timeout_seconds=timeout, reason="command_timeout")
                except (ValueError, TypeError, AttributeError, UnicodeError,
                        RecursionError, OverflowError):
                    pass
            return item("timeout", source, timeout_seconds=timeout)
        except OSError as exc:
            return failure(source, exc)
        # Limits take precedence over exit errors; stderr is never exported.
        if stdout_bytes > limit:
            return item("truncated", source,
                        data[:limit].decode("utf-8", "replace")
                        if key not in JSON_COMPONENTS else None,
                        limit_bytes=limit, bytes_received=stdout_bytes,
                        reason="report_exceeds_limit" if key in JSON_COMPONENTS
                        else "stdout_exceeds_limit")
        if stderr_bytes > 1024 * 1024:
            return item("truncated", source, limit_bytes=1024 * 1024,
                        bytes_received=stderr_bytes, reason="stderr_exceeds_limit")
        if result.returncode != 0:
            return item("error", source, returncode=result.returncode)
        if key == "ai" and not data.strip():
            return item("unavailable", source, returncode=result.returncode,
                        reason="native_ai_no_json_requires_gx_and_gpu_driver")
        if key == "gpu":
            try:
                content = gpu_csv_report(data)
            except (ValueError, TypeError, UnicodeError, csv.Error, OverflowError):
                return item("error", source, reason="invalid_gpu_csv_report")
            return item(content["status"], source, content)
        if key in JSON_COMPONENTS:
            try:
                content = ai_report_json(data) if key == "ai" else json.loads(data)
                if not isinstance(content, dict):
                    raise ValueError("report must be an object")
                # Reject non-finite numbers before they reach the API boundary.
                json.dumps(content, allow_nan=False)
                if key == "ai":
                    content = native_ai_report(content)
                status = diagnostic_report_status(key, content)
                if key == "memgraph":
                    # Export only validated memory graph counters, never other
                    # native plugin results, private text or an invented safe mode.
                    graph = content["memgraph"]
                    graph = {name: graph[name] for name in (
                        "total", "avaliable", "free", "used", "reserved",
                        "userUsed", "kernelUsed", "shmem")
                        if type(graph.get(name)) in (int, float) and
                        0 <= graph[name] <= sys.float_info.max}
                    content = {
                        "version": "2.0", "mode": "native", "tool": "memgraph",
                        "unit": "KiB", "status": status, "graph": graph,
                        "coverage": {"native_plugin_coverage_unknown": True},
                    }
            except (ValueError, TypeError, UnicodeError, RecursionError, OverflowError):
                return item("error", source, reason="invalid_json_report")
            return item(status, source, content, **(
                {"returncode": result.returncode} if key == "ai" else {}))
        return item("ok", source, data.decode("utf-8", "replace"))

    def scope_and_cgroup(self):
        membership = self.read(self.proc_root / "self/cgroup")
        mounts = self.read(self.proc_root / "self/mountinfo")
        if mounts["content"] is not None:
            mounts["content"] = "\n".join(
                line for line in mounts["content"].splitlines()
                if " - cgroup2 " in line)
        namespaces = {}
        for name in ("pid", "mnt", "net", "user", "cgroup", "uts", "ipc", "time"):
            path = self.proc_root / "self/ns" / name
            if self.remaining() <= 0:
                namespaces[name] = item("timeout", str(path), reason="collection_deadline")
                continue
            try:
                namespaces[name] = item("ok", str(path), self.readlink(str(path)))
            except OSError as exc:
                namespaces[name] = failure(str(path), exc)
        scope = {
            "description": item("ok", "collector:scope",
                "Current process namespaces and procfs view, not physical host "
                "inventory. Procfs counters may be host-wide; cgroup v2 files "
                "refer only to the current process cgroup."),
            "namespaces": namespaces, "membership": membership,
            "cgroup2_mounts": mounts,
        }
        unavailable = item("unavailable", "cgroup:v2",
                           reason="current_cgroup_not_resolved")
        for evidence in (membership, mounts):
            if evidence["status"] != "ok":
                unavailable = item(evidence["status"], "cgroup:v2",
                                   reason="scope_evidence_not_available")
                return scope, {name: dict(unavailable) for name in CGROUP_FILES}
        member = next((line[3:] for line in membership["content"].splitlines()
                       if line.startswith("0::")), None)
        mount_root = None
        for line in mounts["content"].splitlines():
            fields = line.split()
            if len(fields) >= 6 and fields[4] == "/sys/fs/cgroup":
                mount_root = fields[3]
                break
        # Resolving against the mount root avoids reporting a parent cgroup as ours.
        if member and mount_root and member.startswith("/"):
            if ".." not in member.split("/") and ".." not in mount_root.split("/"):
                root = mount_root.rstrip("/")
                if member == mount_root or member.startswith(root + "/"):
                    relative = member[len(root):].lstrip("/")
                    base = self.sys_root / "fs/cgroup"
                    candidate = base / relative
                    if os.path.commonpath((str(base.resolve()),
                                           str(candidate.resolve()))) == str(base.resolve()):
                        return scope, {name: self.read(candidate / name)
                                       for name in CGROUP_FILES}
        return scope, {name: dict(unavailable) for name in CGROUP_FILES}

    def bounded_names(self, directory, pattern, deadline):
        names, truncated = [], False
        with self.scandir(str(directory)) as entries:
            for index, entry in enumerate(entries):
                if index >= MAX_DIRECTORY_ENTRIES or self.monotonic() >= deadline:
                    truncated = True
                    break
                if re.fullmatch(pattern, entry.name):
                    names.append(entry.name)
        return names, truncated

    def sysconf_value(self, key):
        try:
            value = self.sysconf(key)
            if not isinstance(value, int) or isinstance(value, bool) or value <= 0:
                raise ValueError("invalid sysconf")
            return value, None
        except (OSError, ValueError) as exc:
            evidence = failure("sysconf:" + key, exc)
            return None, {key: evidence[key] for key in ("source", "status", "errno")
                          if key in evidence}

    def processes(self):
        source = str(self.proc_root) + "/[pid]/{stat,status,io} (current procfs view)"
        clock = self.monotonic()
        deadline = min(clock + PROCESS_SAMPLE_SECONDS,
                       self.deadline if self.deadline is not None else float("inf"))
        ticks, ticks_error = self.sysconf_value("SC_CLK_TCK")
        page_size, page_error = self.sysconf_value("SC_PAGE_SIZE")
        failures = [value for value in (ticks_error, page_error) if value]
        sample = {"sampled_at": self.now(), "monotonic_seconds": clock,
                  "processes": [], "observed": 0, "permission_denied": 0,
                  "vanished": 0, "truncated": False}
        denied, vanished = set(), set()
        if self.deadline is not None and clock >= self.deadline:
            sample["truncated"] = True
            return item("timeout", source, {"clock_ticks": ticks, "page_size": page_size,
                                            "samples": [sample]},
                        sample_statuses=[{"status": "timeout", "failures": [],
                                          "reason": "collection_deadline"}],
                        reason="collection_deadline")

        def read_sample(path):
            if self.monotonic() >= deadline:
                sample["truncated"] = True
                return item("timeout", str(path), reason="sample_deadline")
            return self.read(path)

        def note(pid, name, evidence):
            if evidence["status"] == "ok":
                return
            failures.append({"pid": pid, "file": name, "status": evidence["status"]})
            if evidence["status"] == "permission_denied":
                denied.add(pid)
            if evidence["status"] == "unavailable":
                vanished.add(pid)
            if evidence["status"] == "truncated":
                sample["truncated"] = True

        try:
            names, truncated = self.bounded_names(self.proc_root, r"[0-9]{1,10}", deadline)
            sample["observed"] = len(names)
            sample["truncated"] = truncated or len(names) > MAX_PROCESSES
            # Sort the bounded directory view numerically, independent of readdir order.
            names = sorted(names, key=int)[:MAX_PROCESSES]
            for name in names:
                if self.monotonic() >= deadline:
                    sample["truncated"] = True
                    break
                pid = int(name)
                path = self.proc_root / name
                stat = read_sample(path / "stat")
                process = None
                if stat["status"] == "ok":
                    text = stat["content"]
                    left, right = text.find("("), text.rfind(")")
                    fields = text[right + 1:].split()
                    try:
                        if left < 0 or right <= left or len(fields) < len(STAT_FIELDS):
                            raise ValueError("invalid stat")
                        if int(text[:left].strip()) != pid:
                            raise ValueError("invalid pid")
                        values = dict(zip(STAT_FIELDS, fields))
                        process = {"pid": pid, "comm": text[left + 1:right],
                                   **{key: int(values[key]) for key in
                                      ("starttime", "utime", "stime", "ppid")},
                                   "uid": None, "rss_pages": int(values["rss"])}
                        if any(process[key] < 0 for key in ("starttime", "utime", "stime", "ppid")):
                            raise ValueError("invalid counter")
                    except ValueError:
                        stat.update(status="error", content=None)
                        process = None
                note(pid, "stat", stat)
                if process is None:
                    continue
                status = read_sample(path / "status")
                rss_bytes = (process["rss_pages"] * page_size
                             if page_size is not None and process["rss_pages"] >= 0 else None)
                if status["status"] == "ok":
                    fields = whitelisted_fields(status["content"], STATUS_FIELDS | {"Uid"})
                    uid = fields.get("Uid", "").split()
                    if len(uid) == 4 and all(re.fullmatch(r"[0-9]{1,10}", value) and
                                             int(value) <= (1 << 32) - 1 for value in uid):
                        process["uid"] = int(uid[0])
                    rss = fields.get("VmRSS")
                    if rss is not None:
                        match = re.fullmatch(r"([0-9]+)\s+kB", rss)
                        try:
                            if not match:
                                raise ValueError("invalid VmRSS")
                            rss_bytes = int(match.group(1)) * 1024
                        except ValueError:
                            status.update(status="error", content=None)
                note(pid, "status", status)
                io_evidence = read_sample(path / "io")
                counters = None
                if io_evidence["status"] == "ok":
                    try:
                        fields = whitelisted_fields(io_evidence["content"], IO_FIELDS)
                        counters = {key: int(fields[key]) for key in sorted(IO_FIELDS)}
                        if any(value < 0 for value in counters.values()):
                            raise ValueError("invalid counter")
                    except (KeyError, ValueError):
                        counters = None
                        io_evidence.update(status="error", content=None)
                note(pid, "io", io_evidence)
                process.update(rss_bytes=rss_bytes, io=counters, io_status=io_evidence["status"])
                sample["processes"].append(process)
        except OSError as exc:
            evidence = failure(str(self.proc_root), exc)
            failures.append({"source": evidence["source"], "status": evidence["status"]})
        sample.update(permission_denied=len(denied), vanished=len(vanished))
        status = sample_status(bool(sample["processes"]), failures, sample["truncated"])
        return item(status, source, {"clock_ticks": ticks, "page_size": page_size,
                                    "samples": [sample]},
                    sample_statuses=[{"status": status, "failures": failures}],
                    limit_processes=MAX_PROCESSES,
                    limit_directory_entries=MAX_DIRECTORY_ENTRIES)

    def energy(self):
        base = self.sys_root / "class/powercap"
        clock = self.monotonic()
        deadline = min(clock + ENERGY_SAMPLE_SECONDS,
                       self.deadline if self.deadline is not None else float("inf"))
        sample = {"monotonic_seconds": clock, "zones": []}
        failures, paths, truncated = [], {}, False
        if self.deadline is not None and clock >= self.deadline:
            return item("timeout", str(base), {"samples": [sample]},
                        sample_statuses=[{"status": "timeout", "failures": [],
                                          "reason": "collection_deadline"}],
                        reason="collection_deadline")

        def read_sample(path):
            if self.monotonic() >= deadline:
                return item("timeout", str(path), reason="sample_deadline")
            return self.read(path)

        def note(evidence):
            nonlocal truncated
            if evidence["status"] != "ok":
                failures.append({"path": evidence["source"], "status": evidence["status"]})
            truncated = truncated or evidence["status"] == "truncated"

        try:
            names, truncated = self.bounded_names(
                base, r"(?:intel|amd)-rapl(?::[0-9]+)?", deadline)
            for name in sorted(names):
                if ":" in name:
                    paths[name] = base / name
                else:
                    try:
                        children, capped = self.bounded_names(
                            base / name, r"(?:intel|amd)-rapl:[0-9]+", deadline)
                        truncated = truncated or capped
                        for child in sorted(children):
                            paths.setdefault(child, base / name / child)
                    except OSError as exc:
                        note(failure(str(base / name), exc))
            truncated = truncated or len(paths) > MAX_ZONES
            for name, path in sorted(paths.items())[:MAX_ZONES]:
                if self.monotonic() >= deadline:
                    truncated = True
                    break
                label = read_sample(path / "name")
                note(label)
                if label["status"] != "ok":
                    continue
                label = label["content"].strip()
                # psys and nested core/uncore/dram zones overlap package counters.
                if not re.fullmatch(r"package(?:[-_][0-9]+)?", label):
                    continue
                energy = read_sample(path / "energy_uj")
                maximum = read_sample(path / "max_energy_range_uj")
                values = []
                for evidence in (energy, maximum):
                    value = None
                    if evidence["status"] == "ok":
                        try:
                            value = int(evidence["content"].strip())
                            if value < 0 or (evidence is maximum and value == 0):
                                raise ValueError("invalid energy")
                        except ValueError:
                            value = None
                            evidence.update(status="error", content=None)
                    note(evidence)
                    truncated = truncated or evidence["status"] == "truncated"
                    values.append(value)
                if values[0] is not None:
                    sample["zones"].append({"name": label, "path": str(path),
                                            "energy_uj": values[0],
                                            "max_energy_range_uj": values[1]})
        except OSError as exc:
            note(failure(str(base), exc))
        if not sample["zones"] and not failures:
            failures.append({"path": str(base), "status": "unavailable"})
        status = sample_status(bool(sample["zones"]), failures, truncated)
        return item(status, str(base), {"samples": [sample]},
                    sample_statuses=[{"status": status, "failures": failures}],
                    limit_zones=MAX_ZONES)



def envelope(backend, profile, request_id, started_at):
    return {
        "schema_version": "1.0", "request_id": request_id,
        "collector": {"name": "sysak", "command": "idc", "version": "1.0.0"},
        "device": dict(backend.device),
        "collection": {"profile": profile, "started_at": started_at,
                       "finished_at": started_at, "duration_ms": 0, "status": "ok"},
        "resources": {}, "configuration": {}, "diagnostics": {},
        "capabilities": {"read_only": True, "supported_profiles": list(PROFILES),
                         "unsupported_actions": ["cleanup", "optimize", "process-kill"]},
    }


def collect(backend, profile, request_id, sample_ms):
    started, start_clock = timestamp(), backend.monotonic()
    report = envelope(backend, profile, request_id, started)
    backend.deadline = start_clock + MAX_COLLECTION_SECONDS
    if profile in ("resources", "inspection"):
        resources = report["resources"]
        sampled = {"cpu": "stat", "disk": "diskstats", "network": "net/dev"}
        for key, path in sampled.items():
            resources[key] = [backend.read(backend.proc_root / path)]
        process_sample = backend.processes()
        energy_sample = backend.energy()
        backend.sleep(min(sample_ms / 1000.0, backend.remaining()))
        for key, path in sampled.items():
            resources[key].append(backend.read(backend.proc_root / path))
        resources["processes"] = paired(process_sample, backend.processes())
        resources["energy_uj"] = paired(energy_sample, backend.energy())
        resources["cpu_count"] = cpu_count(resources["cpu"][-1])
        report["collection"]["sample_ms"] = sample_ms
        resources.update({key: backend.read(backend.proc_root / path)
                          for key, path in PROC_FILES.items()})
        resources["scope"], resources["cgroup_v2"] = backend.scope_and_cgroup()
        resources["root_filesystem"] = backend.root_filesystem()
        resources["gpu"] = backend.command("gpu")
    if profile == "inspection":
        diagnostics = report["diagnostics"]
        for key in ("root_filesystem", "meminfo", "vmstat", "psi_cpu",
                    "psi_memory", "psi_io", "file_nr", "file_max", "gpu"):
            diagnostics[key] = report["resources"][key]
        for key in DIAGNOSTIC_FLAGS:
            diagnostics[key] = backend.command(key)
        diagnostics["failed_units"] = backend.command("failed_units")
        diagnostics["logs"] = {
            "printk": backend.read(backend.proc_root / "sys/kernel/printk"),
            "journal_disk_usage": backend.command("journal_usage"),
        }
        diagnostics["agent"] = item("unavailable", "application:agent",
                                    reason="requires_application_integration")
    report["collection"].update(
        finished_at=timestamp(),
        duration_ms=max(0, round((backend.monotonic() - start_clock) * 1000)),
        status=combined_status(list(raw_items({key: report[key] for key in (
            "resources", "configuration", "diagnostics")}))),
    )
    return report


def encode_report(report, max_bytes=MAX_JSON_BYTES):
    def encode():
        return (json.dumps(report, ensure_ascii=False, allow_nan=False,
                           separators=(",", ":")) + "\n").encode("utf-8")
    data = encode()
    if len(data) <= max_bytes:
        return data
    evidence = list(raw_items({key: report[key] for key in (
        "resources", "configuration", "diagnostics")}))
    evidence.sort(key=lambda value: len(json.dumps(value["content"],
                  ensure_ascii=False).encode("utf-8")), reverse=True)
    for value in evidence:
        if value["content"] is None:
            continue
        omitted = len(json.dumps(value["content"], ensure_ascii=False).encode("utf-8"))
        value.update(original_status=value["status"], status="truncated",
                     content=None, omitted_bytes=omitted, reason="total_json_limit")
        report["collection"]["status"] = "partial"
        data = encode()
        if len(data) <= max_bytes:
            return data
    # A bounded envelope remains useful even if per-item metadata fills the budget.
    for key in ("resources", "configuration", "diagnostics"):
        report[key] = {}
    report["diagnostics"]["output"] = item("truncated", "collector:output",
                                           reason="total_json_limit", limit_bytes=max_bytes)
    data = encode()
    if len(data) > max_bytes:
        raise ValueError("JSON budget cannot fit the envelope")
    return data


MAX_ACTION_INPUT_BYTES = 16384
MAX_CHECK_TARGETS = 100
MAX_TERMINATE_TARGETS = 10
MAX_SAFE_INTEGER = (1 << 53) - 1
MAX_PID = (1 << 31) - 1
MAX_ANCESTRY_READS = 128
MAX_ACTION_READS = 32768
MAX_ACTION_SECONDS = 5
MAX_PROBE_SECONDS = 0.25
ACTION_STATUS_FIELDS = frozenset(("Uid", "Gid", "CapInh", "CapPrm", "CapEff", "CapAmb"))
ESSENTIAL_PROCESS_NAMES = frozenset((
    "init", "systemd", "kthreadd", "udevd", "dbus-daemon", "dbus-broker",
    "dbus-broker-lau", "gnome-shell", "gnome-session", "gnome-session-b",
    "X", "Xorg", "Xwayland", "kwin_wayland", "kwin_x11", "plasmashell",
    "plasma_session", "startplasma-way", "startplasma-x11", "weston", "sway",
    "Hyprland", "cinnamon", "cinnamon-sessio", "mate-session", "marco",
    "xfce4-session", "xfce4-panel", "xfwm4", "xfdesktop", "gdm", "gdm3",
    "gdm-session-wor", "gdm-wayland-ses", "gdm-x-session", "lightdm", "sddm",
    "sshd", "login", "elogind", "polkitd", "NetworkManager", "networkd",
    "pulseaudio", "pipewire", "pipewire-pulse", "wireplumber", "cron", "crond",
    "journald", "rsyslogd", "sysak",
))
ESSENTIAL_PROCESS_PREFIXES = ("systemd-", "gsd-", "kworker", "ksoftirqd/",
                              "migration/", "watchdog/", "rcu_", "cpuhp/")
ESSENTIAL_USER_SERVICE_PREFIXES = (
    "systemd-", "org.gnome.Shell", "org.gnome.SettingsDaemon.", "gnome-session",
    "gnome-remote-desktop", "plasma-kwin", "plasma-plasmashell",
    "plasma-ksmserver", "plasma-workspace", "plasma-kded", "xfce4-session",
    "cinnamon-session", "mate-session", "pipewire", "pulseaudio", "wireplumber",
)


class ProcessActionError(Exception):
    def __init__(self, status, reason):
        self.status, self.reason = status, reason


def action_os_error(exc):
    code = getattr(exc, "errno", None)
    if code in (errno.ENOENT, errno.ESRCH):
        return ProcessActionError("gone", "process_gone")
    if code in (errno.EACCES, errno.EPERM):
        return ProcessActionError("permission_denied", "access_denied")
    return ProcessActionError("unsupported", "process_interface_unavailable")


def action_request(stream, deadline, monotonic=time.monotonic):
    # Pipe input must reach EOF within the action budget. Never wait indefinitely
    # for a controller that leaves stdin open, and never accept a path or command.
    stream = getattr(stream, "buffer", stream)
    try:
        fd = stream.fileno()
    except (AttributeError, OSError, ValueError):
        data = stream.read(MAX_ACTION_INPUT_BYTES + 1)
        if isinstance(data, str):
            data = data.encode("utf-8")
    else:
        chunks, size = [], 0
        while True:
            remaining = deadline - monotonic()
            if remaining <= 0 or not select.select([fd], [], [], remaining)[0]:
                raise ValueError("input deadline")
            chunk = os.read(fd, min(4096, MAX_ACTION_INPUT_BYTES + 1 - size))
            if not chunk:
                break
            chunks.append(chunk)
            size += len(chunk)
            if size > MAX_ACTION_INPUT_BYTES:
                raise ValueError("input limit")
        data = b"".join(chunks)
    if len(data) > MAX_ACTION_INPUT_BYTES or monotonic() >= deadline:
        raise ValueError("input limit")

    def unique_object(pairs):
        result = {}
        for key, value in pairs:
            if key in result:
                raise ValueError("duplicate key")
            result[key] = value
        return result

    def invalid_constant(value):
        raise ValueError("non-finite number")

    request = json.loads(data.decode("utf-8"), object_pairs_hook=unique_object,
                         parse_constant=invalid_constant)
    if not isinstance(request, dict) or set(request) != {"manager_pid", "targets"}:
        raise ValueError("invalid request")
    if type(request["manager_pid"]) is not int or not 1 <= request["manager_pid"] <= MAX_PID:
        raise ValueError("invalid manager")
    targets = request["targets"]
    if not isinstance(targets, list) or len(targets) > MAX_CHECK_TARGETS:
        raise ValueError("invalid targets")
    seen = set()
    for target in targets:
        if not isinstance(target, dict) or set(target) != {"pid", "starttime"}:
            raise ValueError("invalid target")
        pid, starttime = target["pid"], target["starttime"]
        if (type(pid) is not int or not 1 <= pid <= MAX_PID or pid in seen or
                type(starttime) is not int or not 0 <= starttime <= MAX_SAFE_INTEGER):
            raise ValueError("invalid identity")
        seen.add(pid)
    return request


class ProcessActions:
    """Fixed procfs probes and pidfds only; injection is internal, not CLI input."""
    def __init__(self, opener=None, pidfd_open=None, send_signal=None, close=None,
                 getpid=None, getresuid=None, getresgid=None, monotonic=None,
                 caller_uid=None, peer_identity=None):
        self.opener = opener or open
        self.pidfd_open = pidfd_open or getattr(os, "pidfd_open", None)
        self.send_signal = send_signal or getattr(signal, "pidfd_send_signal", None)
        self.close = close or os.close
        self.getpid = getpid or os.getpid
        self.getresuid = getresuid or getattr(os, "getresuid", None)
        self.getresgid = getresgid or getattr(os, "getresgid", None)
        self.monotonic = monotonic or time.monotonic
        self.caller_uid = caller_uid
        self.peer_identity = peer_identity
        self.deadline = None
        self.probe_deadline = None
        self.reads = 0

    def budget(self):
        now = self.monotonic()
        if (self.reads >= MAX_ACTION_READS or now >= self.deadline or
                (self.probe_deadline is not None and now >= self.probe_deadline)):
            raise ProcessActionError("unsupported", "probe_limit")

    def read(self, pid, name):
        self.budget()
        self.reads += 1
        try:
            with self.opener("/proc/%d/%s" % (pid, name), "rb") as stream:
                data = stream.read(MAX_FILE_BYTES + 1)
        except OSError as exc:
            raise action_os_error(exc)
        self.budget()
        if len(data) > MAX_FILE_BYTES:
            raise ProcessActionError("unsupported", "invalid_proc_metadata")
        return data.decode("utf-8", "replace")

    def stat(self, pid):
        text = self.read(pid, "stat")
        left, right = text.find("("), text.rfind(")")
        fields = text[right + 1:].split()
        try:
            if left < 0 or right <= left or len(fields) < len(STAT_FIELDS):
                raise ValueError("invalid stat")
            if int(text[:left].strip()) != pid:
                raise ValueError("invalid pid")
            ppid, starttime = int(fields[1]), int(fields[19])
            name = text[left + 1:right]
            if not 0 <= ppid <= MAX_PID or not 0 <= starttime <= MAX_SAFE_INTEGER or len(name) > 64:
                raise ValueError("invalid stat identity")
        except ValueError:
            raise ProcessActionError("unsupported", "invalid_proc_metadata")
        return {"pid": pid, "ppid": ppid, "starttime": starttime, "name": name}

    def credentials(self, pid):
        fields = whitelisted_fields(self.read(pid, "status"), ACTION_STATUS_FIELDS)
        try:
            values = {}
            for key in ("Uid", "Gid"):
                parts = fields[key].split()
                if len(parts) != 4 or not all(re.fullmatch(r"[0-9]+", part) for part in parts):
                    raise ValueError("invalid ids")
                values[key] = tuple(int(part) for part in parts)
            for key in ("CapInh", "CapPrm", "CapEff", "CapAmb"):
                # Missing capability metadata must fail closed.
                if not re.fullmatch(r"[0-9a-fA-F]{1,16}", fields[key]):
                    raise ValueError("invalid capabilities")
                values[key] = int(fields[key], 16)
        except (KeyError, ValueError):
            raise ProcessActionError("unsupported", "invalid_proc_metadata")
        return values

    def ordinary_user(self, credentials, uid):
        if uid <= 0 or credentials["Uid"] != (uid,) * 4:
            raise ProcessActionError("permission_denied", "root_or_other_user")
        if (len(set(credentials["Gid"])) != 1 or 0 in credentials["Gid"] or
                any(credentials[key] for key in ("CapInh", "CapPrm", "CapEff", "CapAmb"))):
            raise ProcessActionError("permission_denied", "elevated_process")

    def runtime(self):
        if self.getresuid is None or self.getresgid is None:
            raise ProcessActionError("unsupported", "identity_interface_unavailable")
        uids, gids = self.getresuid(), self.getresgid()
        if self.caller_uid is not None:
            # Elevation never changes the allowed owner, including on rechecks.
            if (type(self.caller_uid) is not int or not 0 < self.caller_uid < (1 << 32) - 1 or
                    uids != (0,) * 3 or gids != (0,) * 3):
                raise ProcessActionError("permission_denied", "elevated_runtime")
            credentials = self.credentials(self.getpid())
            if credentials["Uid"] != (0,) * 4 or credentials["Gid"] != (0,) * 4:
                raise ProcessActionError("permission_denied", "elevated_runtime")
            return self.caller_uid
        if len(set(uids)) != 1 or len(set(gids)) != 1 or uids[0] <= 0 or gids[0] <= 0:
            raise ProcessActionError("permission_denied", "elevated_runtime")
        credentials = self.credentials(self.getpid())
        self.ordinary_user(credentials, uids[0])
        if credentials["Gid"] != (gids[0],) * 4:
            raise ProcessActionError("permission_denied", "elevated_runtime")
        return uids[0]

    def ancestry(self, pid):
        # At most 128 stat reads per walk, including a second validation pass.
        # No /proc scan, target FD inspection, cmdline or environment collection.
        chain, seen = [], set()
        try:
            for _ in range(MAX_ANCESTRY_READS // 2):
                if pid in seen or pid <= 0:
                    raise ProcessActionError("protected", "ancestry_unverified")
                seen.add(pid)
                current = self.stat(pid)
                chain.append(current)
                if pid == 1:
                    break
                pid = current["ppid"]
            else:
                raise ProcessActionError("protected", "ancestry_unverified")
            for current in reversed(chain):
                if self.stat(current["pid"]) != current:
                    raise ProcessActionError("protected", "ancestry_unverified")
        except ProcessActionError:
            raise ProcessActionError("protected", "ancestry_unverified")
        return chain

    def manager_chain(self, manager_pid, manager_identity=None):
        chain = self.ancestry(self.getpid())
        if self.peer_identity is not None:
            # A daemon worker is not descended from its authenticated socket peer.
            manager = self.stat(manager_pid)
            if (self.caller_uid is None or
                    manager["pid"] != self.peer_identity["pid"] or
                    manager["starttime"] != self.peer_identity["starttime"] or
                    (manager_identity is not None and manager != manager_identity)):
                raise ProcessActionError("protected", "manager_not_verified_peer")
            chain.extend(self.ancestry(manager_pid))
        else:
            manager = next((entry for entry in chain[1:] if entry["pid"] == manager_pid), None)
            if manager is None or (manager_identity is not None and manager != manager_identity):
                raise ProcessActionError("protected", "manager_not_verified_ancestor")
        return chain, manager

    def privileged_target(self, current):
        credentials = self.credentials(current["pid"])
        if len(set(credentials["Uid"])) != 1 or len(set(credentials["Gid"])) != 1:
            raise ProcessActionError("protected", "unstable_target_credentials")
        text = self.read(current["pid"], "stat")
        fields = text[text.rfind(")") + 1:].split()
        try:
            flags = int(fields[6])
            if not 0 <= flags <= (1 << 64) - 1:
                raise ValueError("invalid flags")
        except (IndexError, ValueError):
            raise ProcessActionError("protected", "kernel_identity_unknown")
        if current["ppid"] == 2 or flags & 0x00200000:
            raise ProcessActionError("protected", "kernel_thread")
        memberships = self.read(current["pid"], "cgroup").splitlines()
        paths = []
        systemd = False
        for line in memberships:
            parts = line.split(":", 2)
            if len(parts) != 3 or not parts[0].isdecimal() or not parts[2].startswith("/"):
                raise ProcessActionError("protected", "system_scope_unknown")
            components = parts[2].split("/")
            if any(part in (".", "..") or "\0" in part for part in components):
                raise ProcessActionError("protected", "system_scope_unknown")
            services = tuple(part for part in components if part.endswith(".service") and
                             not re.fullmatch(r"user@[0-9]+\.service", part))
            if "system.slice" in components or (services and "user.slice" not in components):
                raise ProcessActionError("protected", "system_service")
            if any(service.startswith(ESSENTIAL_USER_SERVICE_PREFIXES) for service in services):
                raise ProcessActionError("protected", "essential_user_service")
            if (parts[0] == "0" and parts[1] == "") or "name=systemd" in parts[1].split(","):
                systemd = True
                if ("user.slice" not in components or
                        not (services or any(part.endswith(".scope") for part in components))):
                    raise ProcessActionError("protected", "system_scope_unknown")
            paths.append(tuple(parts))
        if not systemd:
            raise ProcessActionError("protected", "system_scope_unknown")
        return credentials, flags, tuple(paths)

    def policy(self, current, manager_pid, manager_identity, uid):
        if current["pid"] == 1:
            raise ProcessActionError("protected", "pid_one")
        if (current["name"] in ESSENTIAL_PROCESS_NAMES or
                current["name"].startswith(ESSENTIAL_PROCESS_PREFIXES)):
            raise ProcessActionError("protected", "essential_process")
        if self.runtime() != uid:
            raise ProcessActionError("permission_denied", "runtime_identity_changed")
        helpers, manager = self.manager_chain(manager_pid, manager_identity)
        self.ordinary_user(self.credentials(manager["pid"]), uid)
        if current["pid"] in {entry["pid"] for entry in helpers}:
            raise ProcessActionError("protected", "helper_ancestor")
        chain = self.ancestry(current["pid"])
        if chain[0] != current:
            raise ProcessActionError("stale", "process_identity_changed")
        if any(entry["pid"] == manager_pid for entry in chain):
            raise ProcessActionError("protected", "manager_tree")
        if self.caller_uid is not None and self.peer_identity is not None:
            return self.privileged_target(current)
        self.ordinary_user(self.credentials(current["pid"]), uid)

    def probe(self, action, target, manager_pid, manager_identity, uid):
        result = dict(target, name="", eligible=False, status="unsupported", reason="probe_limit")
        fd = None
        self.probe_deadline = min(self.deadline, self.monotonic() + MAX_PROBE_SECONDS)
        try:
            self.budget()
            if self.pidfd_open is None or self.send_signal is None:
                raise ProcessActionError("unsupported", "pidfd_unavailable")
            # Open BEFORE probing the numeric PID. A reused PID can never cause
            # a later numeric kill: the sole signal destination is this pidfd.
            fd = self.pidfd_open(target["pid"], 0)
            current = self.stat(target["pid"])
            result["name"] = current["name"]
            if current["starttime"] != target["starttime"]:
                raise ProcessActionError("stale", "starttime_mismatch")
            evidence = self.policy(current, manager_pid, manager_identity, uid)
            fresh = self.stat(target["pid"])
            if fresh != current:
                raise ProcessActionError("stale", "process_identity_changed")
            # Recheck ancestry, credentials and helper privileges immediately
            # before SIGTERM, not just at an earlier snapshot annotation.
            if self.policy(fresh, manager_pid, manager_identity, uid) != evidence:
                raise ProcessActionError("protected", "target_credentials_or_scope_changed")
            if self.stat(target["pid"]) != fresh:
                raise ProcessActionError("stale", "process_identity_changed")
            self.budget()
            if action == "terminate":
                self.send_signal(fd, signal.SIGTERM, None, 0)
                result.update(eligible=True, status="signalled", reason="sigterm_sent")
            else:
                result.update(eligible=True, status="eligible", reason="policy_passed")
        except OSError as exc:
            error = action_os_error(exc)
            result.update(status=error.status, reason=error.reason)
        except ProcessActionError as exc:
            result.update(status=exc.status, reason=exc.reason)
        except Exception:
            result.update(status="unsupported", reason="process_probe_failed")
        finally:
            if fd is not None:
                try:
                    self.close(fd)
                except OSError:
                    pass
            self.probe_deadline = None
        return result

    def run(self, action, request, deadline):
        self.deadline, self.reads = deadline, 0
        targets = request["targets"]
        try:
            uid = self.runtime()
            _, manager = self.manager_chain(request["manager_pid"])
            self.ordinary_user(self.credentials(manager["pid"]), uid)
        except (ProcessActionError, OSError) as exc:
            error = action_os_error(exc) if isinstance(exc, OSError) else exc
            return [dict(target, name="", eligible=False, status=error.status,
                         reason=error.reason) for target in targets]
        except Exception:
            return [dict(target, name="", eligible=False, status="unsupported",
                         reason="process_probe_failed") for target in targets]
        return [self.probe(action, target, request["manager_pid"], manager, uid)
                for target in targets]


def process_action_main(argv, stdin, stdout, stderr, backend=None):
    parser = Parser(prog="sysak idc", description="Bounded pidfd process actions",
                    allow_abbrev=False)
    parser.add_argument("--process-action", required=True, choices=("check", "terminate"))
    args = parser.parse_args(argv)
    report = {"schema_version": "1.0", "action": args.process_action, "results": []}
    if backend is None:
        caller_uid = None
        peer_identity = None
        getresuid, getresgid = getattr(os, "getresuid", None), getattr(os, "getresgid", None)
        if (getresuid is not None and getresgid is not None and
                getresuid() == (0,) * 3 and getresgid() == (0,) * 3):
            # The root service supplies kernel-authenticated identity, never stdin.
            values = [os.environ.get(key, "") for key in (
                "SYSOM_IDC_CALLER_UID", "SYSOM_IDC_PEER_PID", "SYSOM_IDC_PEER_STARTTIME")]
            if all(re.fullmatch(r"[0-9]{1,16}", value) for value in values):
                uid, pid, starttime = map(int, values)
                if 0 < uid < (1 << 32) - 1 and 0 < pid <= MAX_PID and 0 <= starttime <= MAX_SAFE_INTEGER:
                    caller_uid = uid
                    peer_identity = {"pid": pid, "starttime": starttime}
        backend = ProcessActions(caller_uid=caller_uid, peer_identity=peer_identity)
    deadline = backend.monotonic() + MAX_ACTION_SECONDS
    code = 0
    try:
        request = action_request(stdin, deadline, backend.monotonic)
        if args.process_action == "terminate" and len(request["targets"]) > MAX_TERMINATE_TARGETS:
            raise ValueError("terminate target limit")
    except (ValueError, TypeError, OSError, UnicodeError, RecursionError, OverflowError):
        print("idc: invalid or incomplete bounded process-action request", file=stderr)
        code = 2
    else:
        report["results"] = backend.run(args.process_action, request, deadline)
    try:
        stdout.write(json.dumps(report, ensure_ascii=False, allow_nan=False,
                                separators=(",", ":")) + "\n")
        stdout.flush()
    except (OSError, UnicodeError):
        print("idc: cannot write JSON output", file=stderr)
        return 1
    return code


class Parser(argparse.ArgumentParser):
    def _print_message(self, message, file=None):
        super()._print_message(message, sys.stderr)


def sample_value(value):
    try:
        value = int(value)
    except ValueError:
        raise argparse.ArgumentTypeError("sample-ms must be an integer")
    if not 20 <= value <= 1000:
        raise argparse.ArgumentTypeError("sample-ms must be between 20 and 1000")
    return value


def uuid_value(value):
    try:
        return str(uuid.UUID(value))
    except ValueError:
        raise argparse.ArgumentTypeError("request-id must be a UUID")


def write_output(data, path, stdout):
    text = data.decode("utf-8")
    if path == "-":
        stdout.write(text)
        stdout.flush()
        return
    temporary = None
    try:
        with tempfile.NamedTemporaryFile(mode="wb", dir=str(Path(path).absolute().parent),
                                         prefix=".idc-", delete=False) as stream:
            temporary = stream.name
            stream.write(data)
        os.replace(temporary, path)
        temporary = None
    finally:
        if temporary is not None:
            os.unlink(temporary)


def main(argv=None, backend=None, stdout=None, stderr=None, stdin=None,
         process_backend=None):
    stdout = stdout if stdout is not None else sys.stdout
    stderr = stderr if stderr is not None else sys.stderr
    argv = list(sys.argv[1:] if argv is None else argv)
    if any(value == "--process-action" or value.startswith("--process-action=") for value in argv):
        return process_action_main(argv, stdin if stdin is not None else sys.stdin,
                                   stdout, stderr, process_backend)
    parser = Parser(prog="sysak idc", description="Read-only local IDC evidence as JSON",
                    epilog="Separate process API: --process-action {check,terminate}, JSON stdin only.",
                    allow_abbrev=False)
    parser.add_argument("--profile", choices=PROFILES, default="resources")
    parser.add_argument("--request-id", type=uuid_value)
    parser.add_argument("--sample-ms", type=sample_value, default=200)
    parser.add_argument("-o", "--output", default="-")
    args = parser.parse_args(argv)
    backend = backend or Backend()
    request_id = args.request_id or str(uuid.uuid4())
    try:
        report = collect(backend, args.profile, request_id, args.sample_ms)
        data = encode_report(report)
    except Exception as exc:
        report = envelope(backend, args.profile, request_id, timestamp())
        report["collection"]["status"] = "error"
        report["diagnostics"]["collector"] = item(
            "error", "collector:idc", error_type=type(exc).__name__)
        data = encode_report(report)
    try:
        write_output(data, args.output, stdout)
    except (OSError, UnicodeError):
        print("idc: cannot write JSON output", file=stderr)
        return 1
    status = report["collection"]["status"]
    if status != "ok":
        print("idc: collection is %s; see JSON item statuses" % status, file=stderr)
    return 1 if status == "error" else 0


if __name__ == "__main__":
    sys.exit(main())
