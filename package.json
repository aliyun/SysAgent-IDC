{
  "name": "sysagent-releases",
  "version": "0.2.17",
  "private": true,
  "license": "MIT",
  "description": "SysAgent 所有本地发行版的统一版本和构建入口",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:desktop": "node scripts/build.mjs --target desktop",
    "build:ide": "node scripts/build.mjs --target ide",
    "build:web": "node scripts/build.mjs --target web",
    "dev": "npm --prefix sysagent-idc run dev:web",
    "preview": "npm --prefix sysagent-idc run preview -- --host 127.0.0.1 --port 4173 --strictPort",
    "test": "node --test scripts/build.test.mjs",
    "test:api": "npm --prefix sysagent-idc run build:openapi && node --test sysagent-idc/tests/query-data.test.cjs sysagent-idc/tests/local-query-api.test.cjs",
    "sync:versions": "node scripts/sync-versions.mjs",
    "check:versions": "node scripts/sync-versions.mjs --check",
    "release": "node scripts/build.mjs"
  }
}
